# Copy to backend/.env for local development. Never commit the populated file.
# Backend only. Never use VITE_ prefixes for secrets.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=
ADMIN_DATABASE_URL=
AUTH_SECRET=
ENABLE_PUBLIC_DEMO=false
# Keep live model calls disabled until configuration and access controls are tested.
ENABLE_LIVE_GENERATION=false
DAILY_GENERATION_LIMIT=10
# Optional prices, supplied explicitly for the configured model. Blank means cost unknown.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
